DATABASE_URL=mongodb://localhost:27017/internarea
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# Stringified contents of the Firebase Admin service-account JSON file.
# Required in Render production; do not commit the JSON file itself.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account"}

# Configure an SMTP provider to deliver login verification codes to inboxes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM="InternArea <no-reply@example.com>"

# Optional SMS delivery for password recovery. Without these in development,
# SMS contents are printed to the backend terminal; production requires all 3.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
