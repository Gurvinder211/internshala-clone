DATABASE_URL=mongodb://localhost:27017/internarea
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000,https://internshala-clone-git-main-gurvinders-projects-60de784b.vercel.app,https://internshala-clone-wheat.vercel.app

# Stringified contents of the Firebase Admin service-account JSON file.
# Required in Render production; do not commit the JSON file itself.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account"}

# Gmail SMTP works with a Google App Password (2-Step Verification required).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM="InternArea <yourname@gmail.com>"

# Email API alternatives if SMTP is unavailable on your hosting plan.
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="InternArea <no-reply@example.com>"

# Optional SMS delivery for password recovery. Without these in development,
# SMS contents are printed to the backend terminal; production requires all 3.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
